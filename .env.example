# Copy to .env for local development (`npm run dev`). Never commit real values.
# On Netlify, set these under Site configuration → Environment variables (Functions scope).

# --- Razorpay ---
# Use rzp_test_* keys locally; live keys only in production.
# The server returns the public key ID with each order; the secret never reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook: events are verified and logged, not persisted.
# URL: https://<domain>/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Smart AI resume import (optional) ---
# Server-side Gemini key for the AI bridge (/api/ai/resume) so visitors need no key of their own.
# Create one at https://aistudio.google.com/app/apikey and set a quota/budget in Google Cloud.
GEMINI_API_KEY=
# Optional: model override (default gemini-3.8-flash) and per-IP requests per 10 minutes (default 12).
# GEMINI_MODEL is a public model name, not a secret — it's excluded from Netlify secrets
# scanning via SECRETS_SCAN_OMIT_KEYS in netlify.toml (its value also ships as the client default).
GEMINI_MODEL=
AI_RATE_LIMIT=